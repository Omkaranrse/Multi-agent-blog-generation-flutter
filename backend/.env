# Groq
GROQ_API_KEY="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"

# Checkpoint persistence: "firestore" (production) or "memory" (local dev, no GCP needed)
CHECKPOINT_BACKEND=memory
GCP_PROJECT_ID=your_gcp_project_id
CHECKPOINT_COLLECTION=blog_checkpoints

# Firebase Auth: set to "false" only for local dev - never in anything reachable
# from the internet.
REQUIRE_AUTH=false

# Comma-separated list of allowed origins for the Flutter web build once you
# have one, e.g. https://your-app.web.app
CORS_ORIGINS=*
